{{ 'labsens-pages.css' | asset_url | stylesheet_tag }}
<div class="labsens-contact labsens-global">
<div class="labsens-contact__image">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager' }}{% else %}<img src="{{ 'labsens-contact.jpg' | asset_url }}" alt="" width="1000" height="1000">{% endif %}</div>
<div class="labsens-contact__content"><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.intro | escape }}</p>
{% assign form_id = 'LabsensContact-' | append: section.id %}
{% form 'contact', id: form_id %}
{% if form.posted_successfully? %}<p role="status">{{ section.settings.success | escape }}</p>{% endif %}
{% if form.errors %}<div id="{{ form_id }}-errors" role="alert" tabindex="-1" autofocus>{{ form.errors | default_errors }}</div>{% endif %}
<div class="labsens-contact__fields">
<div><label for="{{ form_id }}-name">{{ section.settings.name_label | escape }} <span aria-hidden="true">*</span></label><input id="{{ form_id }}-name" name="contact[name]" autocomplete="name" value="{{ form.name | escape }}" required></div>
<div><label for="{{ form_id }}-city">{{ section.settings.city_label | escape }} <span aria-hidden="true">*</span></label><input id="{{ form_id }}-city" name="contact[Ciudad]" autocomplete="address-level2" required></div>
<div class="labsens-contact__wide"><label for="{{ form_id }}-email">{{ section.settings.email_label | escape }} <span aria-hidden="true">*</span></label><input id="{{ form_id }}-email" type="email" {% if form.errors contains 'email' %}aria-invalid="true" aria-describedby="{{ form_id }}-errors"{% endif %} name="contact[email]" autocomplete="email" value="{{ form.email | escape }}" required></div>
<div class="labsens-contact__wide"><label for="{{ form_id }}-body">{{ section.settings.message_label | escape }}</label><textarea id="{{ form_id }}-body" name="contact[body]" rows="4">{{ form.body | escape }}</textarea></div>
<button class="labsens-contact__wide" type="submit">{{ section.settings.send | escape }}</button></div>
{% endform %}
<div class="labsens-contact__details">{{ section.settings.details }}</div>
<div class="labsens-contact__socials">{% for block in section.blocks %}<a href="{{ block.settings.url }}" aria-label="{{ block.settings.label | escape }}" {{ block.shopify_attributes }}>{% assign icon = 'labsens-' | append: block.settings.icon | append: '.svg' %}{{ icon | inline_asset_content }}</a>{% endfor %}</div>
</div></div>
{% schema %}
{
  "name": "Labsens · Contacto",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Escríbenos"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Introducción",
      "default": "Cualquier duda o solicitud que tengas:"
    },
    {
      "type": "text",
      "id": "name_label",
      "label": "Etiqueta nombre",
      "default": "Nombre"
    },
    {
      "type": "text",
      "id": "city_label",
      "label": "Etiqueta ciudad",
      "default": "Ciudad"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Etiqueta correo",
      "default": "Correo electrónico"
    },
    {
      "type": "text",
      "id": "message_label",
      "label": "Etiqueta mensaje",
      "default": "Mensaje"
    },
    {
      "type": "text",
      "id": "send",
      "label": "Botón",
      "default": "Enviar"
    },
    {
      "type": "text",
      "id": "success",
      "label": "Confirmación",
      "default": "Gracias. Hemos recibido tu mensaje."
    },
    {
      "type": "richtext",
      "id": "details",
      "label": "Datos de contacto"
    }
  ],
  "presets": [
    {
      "name": "Labsens · Contacto"
    }
  ],
  "blocks": [
    {
      "type": "social",
      "name": "Red social",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Nombre"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Enlace"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            {
              "value": "instagram",
              "label": "Instagram"
            },
            {
              "value": "youtube",
              "label": "Youtube"
            },
            {
              "value": "facebook",
              "label": "Facebook"
            }
          ],
          "default": "instagram"
        }
      ]
    }
  ]
}
{% endschema %}
