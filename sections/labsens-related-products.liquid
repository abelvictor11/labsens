{% liquid
  assign related_products = section.settings.products
  if related_products == blank
    assign related_collection = section.settings.collection | default: collections.all
    assign related_products = related_collection.products
  endif
  assign shown = 0
%}
{% capture cards %}
  {% for related in related_products limit: 50 %}
    {% unless related.id == product.id %}
      {% if section.settings.same_type == false or section.settings.products != blank or related.type == product.type %}
        <a class="labsens-related__card" href="{{ related.url }}">
          {% if related.featured_image %}
            {{ related.featured_image | image_url: width: 900 | image_tag: widths: '300, 450, 600, 900', sizes: '(min-width: 750px) 25vw, 50vw', loading: 'lazy' }}
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'labsens-related__placeholder' }}
          {% endif %}
          <div class="labsens-related__caption">
            {% if related.type != blank %}<span class="labsens-related__type">{{ related.type | escape }}</span>{% endif %}
            <h3>{{ related.title | escape }}</h3>
            <p>{{ related.price_min | money_without_trailing_zeros }}{% if related.price_varies %} – {{ related.price_max | money_without_trailing_zeros }}{% endif %}</p>
          </div>
        </a>
        {% assign shown = shown | plus: 1 %}
        {% if shown == section.settings.limit %}{% break %}{% endif %}
      {% endif %}
    {% endunless %}
  {% endfor %}
{% endcapture %}
{% if shown > 0 %}
  <section class="labsens-related labsens-global" aria-labelledby="RelatedHeading-{{ section.id }}">
    <h2 id="RelatedHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    <div class="labsens-related__grid">{{ cards }}</div>
  </section>
{% elsif request.design_mode %}
  <p class="labsens-global labsens-related">Selecciona productos o una colección con productos disponibles para mostrar esta sección.</p>
{% endif %}
{% stylesheet %}
  .labsens-related{max-width:1380px;margin:0 auto;padding:45px 20px 20px;color:var(--labsens-ink)}
  .labsens-related h2{font-family:inherit;font-size:30px;font-weight:700;text-align:center;margin:0 0 28px;line-height:1.3}
  .labsens-related__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px}
  .labsens-related a.labsens-related__card{display:block;border:1px solid var(--labsens-ink);background:#fff;text-decoration:none;min-width:0}
  .labsens-related__card>img,.labsens-related__card>svg{display:block;width:100%;height:auto;aspect-ratio:0.915;object-fit:cover;border-bottom:1px solid var(--labsens-ink)}
  .labsens-related__caption{padding:12px 15px 24px}
  .labsens-related__type{display:block;color:var(--labsens-accent);font-size:14px}
  .labsens-related h3{font-family:inherit;font-size:18px;font-weight:400;line-height:1.35;margin:0}
  .labsens-related__caption p{font-size:18px;font-weight:700;margin:0;line-height:1.4}
  @media(max-width:749px){.labsens-related{padding-top:30px}.labsens-related h2{font-size:26px}.labsens-related__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.labsens-related__caption{padding:10px}.labsens-related h3,.labsens-related__caption p{font-size:16px}}
{% endstylesheet %}
{% schema %}
{
  "name":"Labsens · Relacionados",
  "enabled_on":{"templates":["product"]},
  "settings":[
    {"type":"text","id":"heading","label":"Título","default":"Productos relacionados"},
    {"type":"product_list","id":"products","label":"Selección manual (prioritaria)","limit":4},
    {"type":"collection","id":"collection","label":"Colección de origen","info":"Sin selección, se usa el catálogo. Se revisan los primeros 50 productos."},
    {"type":"checkbox","id":"same_type","label":"Mostrar solo productos del mismo tipo","default":false},
    {"type":"range","id":"limit","label":"Número de productos","min":2,"max":4,"step":1,"default":4}
  ],
  "presets":[{"name":"Labsens · Relacionados"}]
}
{% endschema %}
