{{ 'labsens-pages.css' | asset_url | stylesheet_tag }}
<div class="labsens-document labsens-global" style="--document-width: {{ section.settings.width }}px">
  {% if section.settings.show_title %}<h1>{{ page.title | escape }}</h1>{% endif %}
  <div class="labsens-document__body">{{ page.content }}</div>
</div>
{% schema %}
{"name":"Labsens · Página","tag":"section","settings":[{"type":"checkbox","id":"show_title","label":"Mostrar título","default":true},{"type":"range","id":"width","label":"Ancho del contenido","min":800,"max":1400,"step":20,"unit":"px","default":1400}],"presets":[{"name":"Labsens · Página"}]}
{% endschema %}
