{{ 'labsens-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'labsens-home-hero.js' | asset_url }}" defer></script>
<labsens-home-hero class="labsens-home-hero labsens-global" data-autoplay="{{ section.settings.autoplay }}" role="region" aria-label="{{ section.settings.label | escape }}">
  <div class="labsens-home-hero__track">
    {% for block in section.blocks %}
      <div class="labsens-home-hero__slide" {% unless forloop.first %}hidden{% endunless %} {{ block.shopify_attributes }}>
        {% if block.settings.url != blank %}<a href="{{ block.settings.url }}" aria-label="{{ block.settings.alt | escape }}">{% endif %}
        <picture>
          {% if block.settings.mobile_image != blank %}<source media="(max-width: 767px)" srcset="{{ block.settings.mobile_image | image_url: width: 1000 }}">
          {% elsif block.settings.mobile_asset != blank %}<source media="(max-width: 767px)" srcset="{{ block.settings.mobile_asset | asset_url }}">{% endif %}
          {% if forloop.first %}{% render 'labsens-home-image', item: block.settings, loading: 'eager' %}{% else %}{% render 'labsens-home-image', item: block.settings %}{% endif %}
        </picture>
        {% if block.settings.url != blank %}</a>{% endif %}
      </div>
    {% endfor %}
  </div>
  {% if section.blocks.size > 1 %}
    <button class="labsens-home-hero__prev" aria-label="{{ 'accessibility.slideshow_previous' | t }}">‹</button>
    <button class="labsens-home-hero__next" aria-label="{{ 'accessibility.slideshow_next' | t }}">›</button>
    <div class="labsens-home-hero__dots">{% for block in section.blocks %}<button data-slide="{{ forloop.index0 }}" aria-label="{{ 'accessibility.slide_status' | t: index: forloop.index, length: section.blocks.size }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"></button>{% endfor %}</div>
    <button class="labsens-home-hero__pause" aria-label="{{ 'accessibility.slideshow_pause' | t }}" data-pause-label="{{ 'accessibility.slideshow_pause' | t }}" data-play-label="{{ 'accessibility.slideshow_play' | t }}">Ⅱ</button>
  {% endif %}
</labsens-home-hero>
{% schema %}
{
  "name": "Labsens · Carrusel",
  "tag": "section",
  "class": "labsens-home-section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Nombre accesible",
      "default": "Promociones Labsens"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Rotación automática",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Labsens · Carrusel"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Diapositiva",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        },
        {
          "type": "text",
          "id": "asset",
          "label": "Archivo original del tema"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Descripción de imagen"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Imagen móvil"
        },
        {
          "type": "text",
          "id": "mobile_asset",
          "label": "Archivo original móvil"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Enlace"
        }
      ]
    }
  ]
}
{% endschema %}
