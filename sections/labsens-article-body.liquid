{{ 'labsens-blog.css' | asset_url | stylesheet_tag }}
<div class="labsens-article-layout labsens-global">
<div><div class="labsens-article-body">{{ article.content }}</div>
{% assign recommended = article.metafields.labsens.recommended_products.value %}
{% if section.settings.show_products and recommended != blank %}<div class="labsens-article-products"><h2>{{ section.settings.products_heading | escape }}</h2><div>{% for item in recommended %}{% if item.published_at != blank %}<a class="labsens-article-product" href="{{ item.url }}">{% if item.featured_image %}{{ item.featured_image | image_url: width: 600 | image_tag: loading: 'lazy' }}{% endif %}<div><small>{{ item.type | escape }}</small><h3>{{ item.title | escape }}</h3><strong>{{ item.price_min | money_without_trailing_zeros }}{% if item.price_varies %} – {{ item.price_max | money_without_trailing_zeros }}{% endif %}</strong></div></a>{% endif %}{% endfor %}</div></div>{% endif %}
</div>
{% if section.settings.show_related %}<aside class="labsens-article-related"><h2>{{ section.settings.related_heading | escape }}</h2>{% assign count = 0 %}{% for entry in blog.articles %}{% unless entry.id == article.id %}{% assign related = false %}{% for tag in article.tags %}{% if entry.tags contains tag %}{% assign related = true %}{% endif %}{% endfor %}{% if related %}<a href="{{ entry.url }}"><div><h3>{{ entry.title | escape }}</h3><span>{{ section.settings.more | escape }}</span></div>{% if entry.image %}{{ entry.image | image_url: width: 240 | image_tag: loading: 'lazy' }}{% endif %}</a>{% assign count = count | plus: 1 %}{% if count >= section.settings.related_count %}{% break %}{% endif %}{% endif %}{% endunless %}{% endfor %}
<div class="labsens-article-cta"><h2>{{ section.settings.cta_heading | escape }}</h2><p>{{ section.settings.cta_text | escape }}</p><a href="{{ section.settings.cta_url }}">{{ section.settings.cta_label | escape }}</a></div></aside>{% endif %}
</div>
<script type="application/ld+json">{{ article | structured_data }}</script>
{% schema %}
{"name":"Labsens · Contenido blog","tag":"section","settings":[{"type":"checkbox","id":"show_products","label":"Mostrar productos recomendados","default":true},{"type":"text","id":"products_heading","label":"Título productos","default":"Productos recomendados"},{"type":"checkbox","id":"show_related","label":"Mostrar columna relacionada","default":true},{"type":"text","id":"related_heading","label":"Título relacionados","default":"Contenido relacionado"},{"type":"range","id":"related_count","label":"Cantidad de artículos relacionados","min":1,"max":8,"step":1,"default":6},{"type":"text","id":"more","label":"Texto enlace","default":"Leer más »"},{"type":"text","id":"cta_heading","label":"Título invitación","default":"¿Nuevo en el mundo de las velas?"},{"type":"textarea","id":"cta_text","label":"Texto invitación","default":"Nuestros kits incluyen todo lo que necesitas para empezar con éxito."},{"type":"text","id":"cta_label","label":"Texto botón","default":"Comienza tu viaje aquí"},{"type":"url","id":"cta_url","label":"Enlace botón","default":"/collections/all"}],"presets":[{"name":"Labsens · Contenido blog"}]}
{% endschema %}
