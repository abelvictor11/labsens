<div class="labsens-global labsens-footer">
  <div class="labsens-footer__columns">
    <div class="labsens-footer__brand">
      <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} — Inicio">
        {% if section.settings.logo != blank %}{{ section.settings.logo | image_url: width: 400 | image_tag: loading: 'lazy', alt: shop.name }}{% else %}<img class="labsens-footer__logo" src="{{ 'labsens-logo-stacked.svg' | asset_url }}" width="195" height="116" alt="LabSens — Experiencia sensorial" loading="lazy">{% endif %}
      </a>
      {% if section.settings.show_payments %}
        {% if section.settings.payments_image != blank %}{{ section.settings.payments_image | image_url: width: 500 | image_tag: class: 'labsens-footer__payments', loading: 'lazy', alt: 'Medios de pago' }}{% else %}<img class="labsens-footer__payments" src="{{ 'labsens-payments.png' | asset_url }}" width="216" height="58" alt="Pagos seguros por Wompi" loading="lazy">{% endif %}
      {% endif %}
    </div>
    {% for block in section.blocks %}
      <div class="labsens-footer__column" {{ block.shopify_attributes }}>
        <h2>{{ block.settings.heading | escape }}</h2>
        {% if block.settings.menu != blank %}<ul>{% for link in block.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}</ul>{% else %}<div class="labsens-footer__links">{{ block.settings.links }}</div>{% endif %}
      </div>
    {% endfor %}
    <div class="labsens-footer__social">
      <h2>{{ section.settings.social_heading | escape }}</h2>
      <div class="labsens-footer__social-links">
        {% if section.settings.instagram != blank %}<a href="{{ section.settings.instagram }}" aria-label="Instagram">{{ 'labsens-instagram.svg' | inline_asset_content }}</a>{% endif %}
        {% if section.settings.youtube != blank %}<a href="{{ section.settings.youtube }}" aria-label="YouTube">{{ 'labsens-youtube.svg' | inline_asset_content }}</a>{% endif %}
        {% if section.settings.facebook != blank %}<a href="{{ section.settings.facebook }}" aria-label="Facebook">{{ 'labsens-facebook.svg' | inline_asset_content }}</a>{% endif %}
      </div>
      <div class="labsens-footer__company">{{ section.settings.company }}</div>
    </div>
  </div>
  <div class="labsens-footer__copyright">© Copyright {{ 'now' | date: '%Y' }} {{ section.settings.copyright_name | escape }}{% if section.settings.credit_name != blank %} – Sitio creado por {% if section.settings.credit_url != blank %}<a href="{{ section.settings.credit_url }}">{{ section.settings.credit_name | escape }}</a>{% else %}{{ section.settings.credit_name | escape }}{% endif %}{% endif %}</div>
</div>
{% if section.settings.whatsapp_url != blank %}<a class="labsens-whatsapp" href="{{ section.settings.whatsapp_url }}" aria-label="Contactar por WhatsApp">{{ 'labsens-whatsapp.svg' | inline_asset_content }}</a>{% endif %}
{% stylesheet %}
  .labsens-whatsapp{position:fixed;right:45px;bottom:25px;width:56px;height:56px;border-radius:50%;background:#5bce69;color:#fff;display:flex;align-items:center;justify-content:center;z-index:15;box-shadow:0 2px 8px #0002}
  .labsens-whatsapp svg{width:34px;height:34px;fill:currentColor}
  .labsens-whatsapp:focus-visible{outline:2px solid var(--labsens-ink);outline-offset:4px}
  .labsens-footer{background:var(--labsens-peach)}
  .labsens-footer__columns{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:20px;padding:10px;min-height:320px}
  .labsens-footer__columns>div{padding:10px}
  .labsens-footer__brand{display:flex;flex-direction:column;gap:20px;align-items:flex-start}
  .labsens-footer__brand img{height:auto;max-width:100%;display:block}
  .labsens-footer__logo{width:195px}
  .labsens-footer__payments{width:216px}
  .labsens-footer h2{font:700 18px/1 var(--font-heading--family);margin:0 0 20px;text-transform:none;letter-spacing:0}
  .labsens-footer ul{padding:0;margin:0;list-style:none}
  .labsens-footer__column li,.labsens-footer__links p{margin:0;line-height:1.55}
  .labsens-footer__links a{display:inline}
  .labsens-footer__social-links{display:flex;gap:18px;align-items:center;margin-bottom:20px}
  .labsens-footer__social-links a{display:flex}
  .labsens-footer__social-links svg{width:24px;height:24px}
  .labsens-footer__company p{margin:0;line-height:1.5}
  .labsens-footer__copyright{padding:10px;text-align:center;background:var(--labsens-ink);color:#fff;font-size:16px;line-height:24px}
  .labsens-footer__copyright a{color:var(--labsens-peach)}
  @media(max-width:767px){
    .labsens-whatsapp{right:45px;bottom:25px}
    .labsens-footer__columns{grid-template-columns:repeat(20,minmax(0,1fr));gap:20px 0;padding:20px;min-height:0}
    .labsens-footer__columns>div{padding:0;grid-column:span 10}
    .labsens-footer__columns>.labsens-footer__column:nth-child(2){grid-column:span 12;padding-right:15px}
    .labsens-footer__columns>.labsens-footer__column:nth-child(3){grid-column:span 8}
    .labsens-footer__columns>.labsens-footer__brand{grid-column:1/-1}
    .labsens-footer__brand{grid-column:1/-1;flex-direction:row;align-items:center;gap:20px;margin-bottom:0}
    .labsens-footer__brand>a{width:35%;flex-shrink:0}
    .labsens-footer__brand .labsens-footer__payments{width:55%;max-width:200px}
    .labsens-footer h2{margin-bottom:10px}
    .labsens-footer__column{padding-right:15px}
    .labsens-footer__column li,.labsens-footer__links p{line-height:1.6}
    .labsens-footer__social-links{gap:10px;margin-bottom:20px}
    .labsens-footer__copyright{font-size:12px;line-height:18px}
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Labsens · Footer",
  "tag": "footer",
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "max_blocks": 3,
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo vertical"
    },
    {
      "type": "checkbox",
      "id": "show_payments",
      "label": "Mostrar imagen de medios de pago",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "payments_image",
      "label": "Imagen de medios de pago"
    },
    {
      "type": "paragraph",
      "content": "La imagen reproduce el sitio original; configurar los pagos de Shopify es un paso separado."
    },
    {
      "type": "text",
      "id": "social_heading",
      "label": "Título de redes",
      "default": "Síguenos"
    },
    {
      "type": "url",
      "id": "instagram",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "youtube",
      "label": "YouTube"
    },
    {
      "type": "url",
      "id": "facebook",
      "label": "Facebook"
    },
    {
      "type": "richtext",
      "id": "company",
      "label": "Datos de empresa"
    },
    {
      "type": "text",
      "id": "copyright_name",
      "label": "Nombre en copyright",
      "default": "LabSens"
    },
    {
      "type": "text",
      "id": "credit_name",
      "label": "Crédito del sitio",
      "default": "Pardolikeme"
    },
    {
      "type": "url",
      "id": "credit_url",
      "label": "Enlace del crédito"
    },
    {
      "type": "url",
      "id": "whatsapp_url",
      "label": "WhatsApp flotante"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Columna de enlaces",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Enlaces"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menú de Shopify"
        },
        {
          "type": "richtext",
          "id": "links",
          "label": "Enlaces de respaldo"
        },
        {
          "type": "paragraph",
          "content": "El menú seleccionado sustituye los enlaces de respaldo. Puedes editar sus textos y destinos en el contenido enriquecido."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Labsens · Footer"
    }
  ]
}
{% endschema %}
