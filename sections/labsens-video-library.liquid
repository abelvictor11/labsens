<div class="labsens-video-library labsens-global">
  {% for block in section.blocks %}
    {% if block.settings.video != blank %}
      <div class="labsens-video-library__item" {{ block.shopify_attributes }}>
        <iframe src="https://www.youtube.com/embed/{{ block.settings.video.id | escape }}?controls=1&rel=0&playsinline=1" title="{{ block.settings.title | escape }}" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
      </div>
    {% endif %}
  {% endfor %}
</div>
{% stylesheet %}
.labsens-video-library{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;padding:20px;max-width:1440px;margin:0 auto}
.labsens-video-library__item{aspect-ratio:16/9;min-width:0}
.labsens-video-library iframe{display:block;width:100%;height:100%;border:0}
@media(max-width:767px){.labsens-video-library{grid-template-columns:1fr}}
{% endstylesheet %}
{% schema %}
{"name":"Labsens · Videos","tag":"section","max_blocks":50,"settings":[],"blocks":[{"type":"video","name":"Video","settings":[{"type":"video_url","id":"video","label":"Video de YouTube","accept":["youtube"]},{"type":"text","id":"title","label":"Título accesible","default":"Video tutorial"}]}],"presets":[{"name":"Labsens · Videos"}]}
{% endschema %}
