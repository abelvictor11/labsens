{{ 'labsens-home.css' | asset_url | stylesheet_tag }}
<div class="labsens-home-brands labsens-global"><h2>{{ section.settings.heading | escape }}</h2><div>{% for block in section.blocks %}<div {{ block.shopify_attributes }}>{% render 'labsens-home-image', item: block.settings %}</div>{% endfor %}</div></div>
{% schema %}
{
  "name": "Labsens · Marcas",
  "tag": "section",
  "class": "labsens-home-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Trabajamos con los mejores"
    }
  ],
  "presets": [
    {
      "name": "Labsens · Marcas"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Marca",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        },
        {
          "type": "text",
          "id": "asset",
          "label": "Archivo original del tema"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Descripción de imagen"
        }
      ]
    }
  ]
}
{% endschema %}
