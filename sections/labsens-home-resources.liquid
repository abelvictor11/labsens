{{ 'labsens-home.css' | asset_url | stylesheet_tag }}
<div class="labsens-home-resources labsens-global"><h2>{{ section.settings.heading | escape }}</h2><div class="labsens-home-resources__grid">
{% for block in section.blocks %}<article {{ block.shopify_attributes }}><a class="labsens-home-resources__image" href="{{ block.settings.url }}">{% render 'labsens-home-image', item: block.settings %}<span>{{ block.settings.category | escape }}</span></a><div class="labsens-home-resources__text"><h3><a href="{{ block.settings.url }}">{{ block.settings.title | escape }}</a></h3><a class="labsens-home-resources__more" href="{{ block.settings.url }}">{{ section.settings.more | escape }}</a></div></article>{% endfor %}</div></div>
{% schema %}
{
  "name": "Labsens · Recursos",
  "tag": "section",
  "class": "labsens-home-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Recursos educativos"
    },
    {
      "type": "text",
      "id": "more",
      "label": "Texto del enlace",
      "default": "Leer más »"
    }
  ],
  "presets": [
    {
      "name": "Labsens · Recursos"
    }
  ],
  "blocks": [
    {
      "type": "resource",
      "name": "Recurso",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Enlace"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        },
        {
          "type": "text",
          "id": "asset",
          "label": "Archivo original del tema"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Descripción de imagen"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Categoría editorial"
        }
      ]
    }
  ]
}
{% endschema %}
